---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	router(router)
	triage(triage)
	information(information)
	scheduling(scheduling)
	__end__([<p>__end__</p>]):::last
	__start__ --> router;
	router -.-> information;
	router -.-> scheduling;
	router -.-> triage;
	information --> __end__;
	scheduling --> __end__;
	triage --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
