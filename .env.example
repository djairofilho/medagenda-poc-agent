DATABASE_URL=postgresql+psycopg://medagenda:medagenda@localhost:5432/medagenda
# SQLite alternative for the whole application: DATABASE_URL=sqlite+pysqlite:///./medagenda.db
# Optional: defaults to DATABASE_URL, including SQLite checkpoints in the same file.
# CHECKPOINT_DATABASE_URL=postgresql://medagenda:medagenda@localhost:5432/medagenda
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
# Alternative: LLM_PROVIDER=openai and OPENAI_API_KEY=...
# Local Codex CLI demo: LLM_PROVIDER=codex
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
DEBUG=false
